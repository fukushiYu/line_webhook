graph TB
    subgraph Users["使用者 / LINE 客戶端"]
        LINE[LINE App]
        LIFF[LIFF Browser]
    end

    subgraph External["外部服務"]
        direction TB
        LINE_PLATFORM[LINE Platform]
        GEMINI[Google Gemini API]
    end

    subgraph Web["Web 層 (main.py)"]
        direction TB
        FAVICON[GET /favicon.ico]
        WEBHOOK[POST /webhook/line/{idx}]
        SCOREPAGE[GET /webhook/scorepage]
        CSS[GET /webhook/style.css]
        
        WEBHOOK --> SIGNATURE[HMAC-SHA256 簽章驗證]
        SIGNATURE --> PARSE[解析事件類型]
        PARSE --> DISPATCH_TEXT[文字 / Postback → await]
        PARSE --> DISPATCH_IMG[圖片 → asyncio.create_task]
        PARSE --> DISPATCH_AUDIO[音訊 → asyncio.create_task]
    end

    subgraph Config["設定層 (config.py)"]
        direction TB
        YAML[settings.yaml<br/>settings.local.yaml]
        PROMPTS[prompt/*.txt]
        FLEX[Flex Message 模板]
        YAML --> INCLUDE[!include 解析]
        INCLUDE --> PROMPTS
    end

    subgraph Utils["工具層"]
        LINE_UTILS[line_utils.py]
        LINE_UTILS --> VERIFY[verify_signature]
        LINE_UTILS --> GET_API[get_line_api<br/>AsyncMessagingApi 工廠]
    end

    subgraph Handler["商業邏輯層 (handlers.py)"]
        direction TB
        H_MSG[handle_message]
        H_IMG[handle_image_message]
        H_AUDIO[handle_audio_message]
        H_POSTBACK[handle_postback]

        H_IMG --> OVERLAP_LOCK[重疊檢查<br/>_processing_users]
        H_IMG --> DAILY_LIMIT[每日限額<br/>_user_daily_usage]
        H_IMG --> DOWNLOAD[下載圖片<br/>get_message_content]
        H_IMG --> SAVE_IMG[存檔 images/{uuid}.jpg]
        H_IMG --> REPLY_WAIT[回覆「請稍候」]
        H_IMG --> FINAL_PUSH[推播結果連結]
        H_IMG --> CLEANUP[清理狀態]

        H_AUDIO --> DOWNLOAD_AUDIO[下載音訊]
        H_AUDIO --> SAVE_AUDIO[存檔 audios/{uuid}.{ext}]

        H_MSG --> CMD_GRADE[grade → 評分按鈕]
        H_MSG --> CMD_WELCOME[welcome → 歡迎訊息]
        H_MSG --> CMD_UPLOAD[upload → 上傳提示]
        H_MSG --> CMD_MENU[menu/選單 → 綁定 Rich Menu]
        H_MSG --> CMD_ECHO[其他 → Echo]
    end

    subgraph EssayCheck["作文驗證 (english_essay.py)"]
        IS_ESSAY[is_english_essay]
        IS_ESSAY --> CHK_EMPTY[非空]
        IS_ESSAY --> CHK_WORDS[≥30 字]
        IS_ESSAY --> CHK_SENT[≥2 句]
        IS_ESSAY --> CHK_CAPS[≥50% 句首大寫]
    end

    subgraph AI["AI 服務層 (gemini.py)"]
        direction TB
        OCR[ocr_image<br/>圖片→文字]
        TRANS[transcribe_audio<br/>音訊→文字]
        SCORE_V1[score_essay<br/>V1: 評分→Markdown]
        SCORE_V2[score_essay_direct_html<br/>V2: 評分→HTML]
        MD2HTML[md_to_html<br/>V1: Markdown→HTML]

        OCR --> CALL_GEMINI_MULTI[_call_gemini<br/>多模態呼叫]
        TRANS --> CALL_GEMINI_MULTI
        SCORE_V1 --> CALL_GEMINI_TEXT[_call_gemini_text<br/>純文字呼叫]
        SCORE_V2 --> CALL_GEMINI_TEXT
        MD2HTML --> CALL_GEMINI_TEXT

        CALL_GEMINI_MULTI --> EXTRACT_HTML[_extract_html<br/>萃取程式碼區塊]
        CALL_GEMINI_TEXT --> EXTRACT_HTML
    end

    subgraph Storage["檔案儲存"]
        IMAGES[images/]
        AUDIOS[audios/]
        OUTPUT[output/]
        OUTPUT_MD[output/*.md<br/>V1 中間產物]
        OUTPUT_HTML[output/*.html<br/>最終報表]
    end

    subgraph Static["靜態資源"]
        STYLE[style.css]
        FALLBACK[static/scorepage.html]
    end

    LINE -->|傳送照片| LINE_PLATFORM
    LINE_PLATFORM -->|POST webhook| WEBHOOK
    DISPATCH_IMG --> H_IMG
    H_IMG --> REPLY_WAIT
    H_IMG -->|下載圖片| DOWNLOAD
    DOWNLOAD --> SAVE_IMG
    SAVE_IMG -->|OCR| OCR
    OCR -->|文字結果| IS_ESSAY
    IS_ESSAY -->|驗證通過| SCORE_V2
    SCORE_V2 -->|寫入 HTML| OUTPUT_HTML
    IS_ESSAY -->|驗證失敗| FINAL_PUSH
    FINAL_PUSH -->|Flex + LIFF URI| LINE_PLATFORM
    LINE_PLATFORM -->|推播| LINE
    CLEANUP --> LINE_PLATFORM

    LINE -->|點擊按鈕| LIFF
    LIFF -->|GET scorepage?liff.state=?id=X| SCOREPAGE
    SCOREPAGE -->|讀取 HTML| OUTPUT_HTML
    SCOREPAGE -->|FileResponse| LIFF
    CSS --> STYLE

    LINE -->|語音訊息| LINE_PLATFORM
    LINE_PLATFORM -->|POST webhook| WEBHOOK
    DISPATCH_AUDIO --> H_AUDIO
    H_AUDIO --> DOWNLOAD_AUDIO
    DOWNLOAD_AUDIO --> SAVE_AUDIO
    SAVE_AUDIO -->|轉錄| TRANS
    TRANS -->|回覆文字| LINE_PLATFORM

    LINE -->|輸入指令| LINE_PLATFORM
    LINE_PLATFORM -->|POST webhook| WEBHOOK
    DISPATCH_TEXT --> H_MSG
    H_MSG -->|回應| LINE_PLATFORM

    OCR --> GEMINI
    TRANS --> GEMINI
    SCORE_V2 --> GEMINI

    Config -.->|channel_config| H_IMG
    Config -.->|channel_config| H_AUDIO
    Config -.->|channel_config| H_MSG
    Config -.->|API Keys / Prompt| AI
    Config -.->|Flex Templates| HANDLER
    LINK1[ ] -.-> H_IMG
    LINK2[ ] -.-> H_AUDIO
    LINK3[ ] -.-> H_MSG

    WEBHOOK -.-> VERIFY
    GET_API -.-> LINE_PLATFORM

    SCORE_V1 -.->|寫入 .md| OUTPUT_MD
    OUTPUT_MD -.->|轉 HTML| MD2HTML
    MD2HTML -.->|寫入 .html| OUTPUT_HTML

    classDef user fill:#e1f5fe,stroke:#0288d1
    classDef external fill:#fff3e0,stroke:#f57c00
    classDef web fill:#e8f5e9,stroke:#388e3c
    classDef handler fill:#fce4ec,stroke:#d81b60
    classDef ai fill:#f3e5f5,stroke:#7b1fa2
    classDef storage fill:#efebe9,stroke:#5d4037
    classDef config fill:#e0f7fa,stroke:#00838f
    classDef check fill:#fff8e1,stroke:#f9a825
    classDef util fill:#eceff1,stroke:#546e7a
    classDef static fill:#f1f8e9,stroke:#558b2f

    class LINE,LIFF user
    class LINE_PLATFORM,GEMINI external
    class FAVICON,WEBHOOK,SCOREPAGE,CSS web
    class H_MSG,H_IMG,H_AUDIO,H_POSTBACK handler
    class OCR,TRANS,SCORE_V1,SCORE_V2,MD2HTML ai
    class IMAGES,AUDIOS,OUTPUT,OUTPUT_MD,OUTPUT_HTML storage
    class YAML,FLEX,PROMPTS,INCLUDE config
    class IS_ESSAY,CHK_EMPTY,CHK_WORDS,CHK_SENT,CHK_CAPS check
    class LINE_UTILS,VERIFY,GET_API util
    class STYLE,FALLBACK static
